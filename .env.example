# ─────────────────────────────────────────────────────────────────────────
# Wisest Maths App — environment variables
# Copy to `.env.local` and fill in. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────────────────

# ── Session signing (REQUIRED in production) ───────────────────────────────
# 32+ char random string used to sign session JWTs. Generate with:
#   openssl rand -base64 48
# Without it, dev uses an insecure built-in fallback and production refuses to boot.
SESSION_SECRET=

# ── Supabase (auth + Postgres) ─────────────────────────────────────────────
# When both are set, login verifies credentials against Supabase Auth.
# When unset, dev falls back to a mock verifier (any password) and production
# refuses to boot.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Tenant DB connection (multi-school RLS) ────────────────────────────────
# Direct Postgres connection used ONLY for school-scoped tenant data (classes,
# rosters, assignments). MUST point at the restricted `wisest_app_user` role
# (sql/zero_trust_roles.sql) — NOT the service role — so Row Level Security in
# sql/multi_tenant_schools.sql actually enforces school isolation. Get the
# connection string from Supabase → Project Settings → Database, and swap the
# user/password for wisest_app_user. When unset, class/roster features fall
# back to the single-tenant localStorage store (dev only).
#   postgresql://wisest_app_user:PASSWORD@HOST:5432/postgres
DATABASE_URL=

# ── Wisest staff connection (no-PII back-office) ───────────────────────────
# Restricted `wisest_staff` Postgres role used by Wisest EMPLOYEES to manage
# schools (create / suspend) WITHOUT being able to read student PII — it is
# granted only `schools` + the PII-free views (sql/wisest_staff_and_provisioning.sql).
# Same pooler host as DATABASE_URL, but the wisest_staff role + its password.
# When unset, the super-admin still works via the service-role; the hard DB-level
# PII guarantee only holds once this is set.
#   postgresql://wisest_staff.PROJECTREF:PASSWORD@HOST:5432/postgres?sslmode=disable
DATABASE_URL_WISEST=

# ── AI providers (server-side only) ────────────────────────────────────────
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=   # for /api/assess once wired to Claude

# ── Stripe (Hosted Checkout — scaffolded) ──────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ── App base URL (used for Stripe redirect URLs) ───────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Rate limiting (REQUIRED in production — both vars) ─────────────────────
# Durable, multi-instance rate limiting via Upstash Redis. In production BOTH
# are mandatory: the app refuses to boot without them (validateEnv throws), so
# it can never silently fall back to the in-memory limiter — which is NOT safe
# for production (per-instance, resets on cold start). In dev, leaving them
# unset uses the in-memory fallback. Create a free database at https://upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
