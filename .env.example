# ─────────────────────────────────────────────────────────────────────────
# Wisest Maths App — environment variables
# Copy to `.env.local` and fill in. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────────────────

# ── Session signing (REQUIRED in production) ───────────────────────────────
# 32+ char random string used to sign session JWTs. Generate with:
#   openssl rand -base64 48
# Without it, dev uses an insecure built-in fallback and production refuses to boot.
SESSION_SECRET=

# ── Supabase (auth + Postgres) ─────────────────────────────────────────────
# When both are set, login verifies credentials against Supabase Auth.
# When unset, dev falls back to a mock verifier (any password) and production
# refuses to boot.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI providers (server-side only) ────────────────────────────────────────
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=   # for /api/assess once wired to Claude

# ── Stripe (Hosted Checkout — scaffolded) ──────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ── App base URL (used for Stripe redirect URLs) ───────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Rate limiting (REQUIRED in production) ─────────────────────────────────
# Durable, multi-instance rate limiting via Upstash Redis. When BOTH are set,
# the limiter is backed by Redis (shared across serverless instances and
# cold-start safe); when unset, dev falls back to an in-memory limiter that is
# NOT safe for production. Create a free database at https://upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
